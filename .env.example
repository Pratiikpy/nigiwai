# Copy to .env for local runs. Never commit a real .env.
# The Qloo key is read from QLOO_API_KEY, or from the file named by NIGIWAI_QLOO_KEY_FILE.
# Never paste it here.

NIGIWAI_ENV=development
NIGIWAI_DATABASE_URL=postgresql+asyncpg://nigiwai:nigiwai-dev-only@127.0.0.1:55432/nigiwai
NIGIWAI_DATABASE_URL_SYNC=postgresql+psycopg://nigiwai:nigiwai-dev-only@127.0.0.1:55432/nigiwai
NIGIWAI_REDIS_URL=redis://127.0.0.1:56379/0

# Qloo
QLOO_API_KEY=
NIGIWAI_QLOO_KEY_FILE=
NIGIWAI_QLOO_BASE_URL=https://hackathon.api.qloo.com
NIGIWAI_QLOO_TRANSPORT=harness      # harness | rest
NIGIWAI_QLOO_MODE=live              # live | record | replay

# The address people reach the web app at. QR posters, booking-brief links and team invitation links are built from it, so it must
# be the public address, not localhost, once the app is hosted.
NIGIWAI_PUBLIC_BASE_URL=http://localhost:3000

# Secrets for signing sessions and nonces (generate with: python -c "import secrets;print(secrets.token_urlsafe(48))")
NIGIWAI_SECRET_KEY=change-me-in-real-environments

# The AI-alone comparison beside a Soundcheck (optional). Without a key file the panel says there is no AI answer and shows
# Qloo's side. The key is read on the server only.
NIGIWAI_ANTHROPIC_KEY_FILE=
# Only if the key is not scoped to a single workspace (the service then answers 400 and asks for one): the workspace id, wrkspc_...
NIGIWAI_ANTHROPIC_WORKSPACE_ID=
NIGIWAI_LLM_MODEL=claude-sonnet-5-5
# Or any OpenAI-compatible chat completions service (a hosted open model, a gateway, a local server). The key is read from
# NIGIWAI_LLM_API_KEY or from the file named by NIGIWAI_LLM_KEY_FILE; NIGIWAI_LLM_EXTRA_BODY is JSON merged into every request,
# for a model that otherwise spends its tokens thinking, e.g. {"chat_template_kwargs": {"enable_thinking": false}}.
NIGIWAI_LLM_PROVIDER=anthropic
NIGIWAI_LLM_BASE_URL=
NIGIWAI_LLM_KEY_FILE=
NIGIWAI_LLM_EXTRA_BODY=
NIGIWAI_LLM_DAILY_LIMIT=100

# Public services the API may call. Nominatim and MusicBrainz ask every client to say who it is: use a URL or email you own.
NIGIWAI_LINEUP_CONTACT=
NIGIWAI_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Judge mode: caps on what anonymous visitors to the demo venues can spend, for the whole site, per day. Each new
# check calls Qloo (about four calls), so keep these well inside the monthly allowance.
NIGIWAI_DEMO_RUNS_PER_DAY=60
NIGIWAI_DEMO_SEARCHES_PER_DAY=300
NIGIWAI_DEMO_COMPARES_PER_DAY=100
